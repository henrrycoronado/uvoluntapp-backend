# Entorno local de Uvoluntapp. Copiar a .env y ajustar los valores.
# Este archivo no debe contener credenciales reales.

# Servidor
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
ENABLE_HTTPS_REDIRECTION=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Base de datos local (docker compose)
POSTGRES_USER=uvoluntapp
POSTGRES_PASSWORD=change_me_local
POSTGRES_DB=uvoluntapp
POSTGRES_PORT=5432
# Exporta esta variable al ejecutar la API. Si también se define ConnectionStrings__DefaultConnection, esa tiene prioridad.
DB_CONNECTION_STRING=Host=localhost;Port=5432;Database=uvoluntapp;Username=uvoluntapp;Password=change_me_local

# Redis local (docker compose)
REDIS_PORT=6379
REDIS_CONNECTION_STRING=localhost:6379

# Mailpit local (docker compose)
# SMTP en localhost:1025; interfaz web en http://localhost:8025
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# JWT
JWT_SECRET=change_me_dev_secret_at_least_32_chars
JWT_ISSUER=Uvoluntapp.Backend
JWT_AUDIENCE=UVoluntapp.Client
JWT_EXPIRY_MINUTES=60
JWT_REFRESH_DAYS=15

# Correo (Resend, solo demo)
# En local los correos se capturan en Mailpit; no se necesita clave.
RESEND_API_KEY=re_replace_with_your_key
EMAIL_FROM=Uvoluntapp <no-reply@example.com>

# Almacenamiento (Cloudflare R2, API S3)
# Region auto y path style se configuran en el adaptador.
S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ACCESS_KEY=replace_me
S3_SECRET_KEY=replace_me
STORAGE_UPLOAD_BUCKET=uvoluntapp-bucket
# Dejar vacío: el bucket es privado y los archivos se entregan mediante la API.
STORAGE_PUBLIC_BASE_URL=
STORAGE_FOLDER_PROFILES=dev/profiles
STORAGE_FOLDER_EVIDENCES=dev/evidences

# Google OAuth
GOOGLE_CLIENT_IDS=example-web.apps.googleusercontent.com


# Dos administradores iniciales (SCRUM-106): se crean al arrancar en cualquier entorno, una sola vez.
FOUNDER_ADMIN_1_EMAIL=
FOUNDER_ADMIN_1_PASSWORD=
FOUNDER_ADMIN_2_EMAIL=
FOUNDER_ADMIN_2_PASSWORD=

# URL pública de la web, para los enlaces de los correos (recuperación de contraseña).
WEB_BASE_URL=http://localhost:5173

# Periodos académicos sembrados al arrancar (M2 no los gestiona). En Development, si falta, se siembra el año en curso.
ACADEMIC_PERIODS=2026-1:2026-02-01:2026-07-15;2026-2:2026-08-01:2026-12-15
